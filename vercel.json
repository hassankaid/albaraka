{
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/studio/demarrer.ts": {
      "includeFiles": "studio/**",
      "maxDuration": 60
    },
    "api/studio/banque-indexer.ts": {
      "includeFiles": "studio/*.py",
      "maxDuration": 60
    },
    "api/appels/demarrer.ts": {
      "includeFiles": "studio/appel.py",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/livraison-tunnels(.html)?",
      "has": [
        {
          "type": "host",
          "value": "^((www\\.)?albarakaecosysteme\\.com|event\\.albarakaecosysteme\\.com)$"
        }
      ],
      "destination": "https://plateforme.albarakaecosysteme.com/livraison-tunnels",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^.+\\.vercel\\.app$"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data/autoriser",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/mcp",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/mcp"
    },
    {
      "source": "/data/register",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/register"
    },
    {
      "source": "/data/token",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/token"
    },
    {
      "source": "/data/api/autoriser",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/autoriser"
    },
    {
      "source": "/data/api/client",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/client"
    },
    {
      "source": "/data/autoriser",
      "destination": "/connecteur.html"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:chemin*",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:chemin*",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/connecteur-equipe/.well-known/oauth-authorization-server"
    },
    {
      "source": "/s/:token/:seq",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/r-sms?t=:token&s=:seq"
    },
    {
      "source": "/s/:token",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/r-sms?t=:token"
    },
    {
      "source": "/stop/:token",
      "destination": "https://ktvszjzryabjgxyobtyc.supabase.co/functions/v1/desabonnement?t=:token"
    },
    {
      "source": "/(webinaire|vsl|appel-conference|temoignages|al-baraka-200|liberty|video-1|video-2|video-3|mentions-legales|politique-de-confidentialite|conditions-generales-de-vente)",
      "has": [
        {
          "type": "host",
          "value": "^event\\.(albarakaecosysteme|albarakabyethicarena)\\.com$"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/(webinaire|vsl|appel-conference|temoignages|al-baraka-200|liberty|video-1|video-2|video-3|mentions-legales|politique-de-confidentialite|conditions-generales-de-vente)/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^event\\.(albarakaecosysteme|albarakabyethicarena)\\.com$"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "^event\\.(albarakaecosysteme|albarakabyethicarena)\\.com$"
        }
      ],
      "destination": "/introuvable.html"
    },
    {
      "source": "/desabonnement",
      "destination": "/desabonnement.html"
    },
    {
      "source": "/livraison-tunnels",
      "has": [
        {
          "type": "host",
          "value": "(plateforme\\.|view\\.)albarakaecosysteme\\.com"
        }
      ],
      "destination": "/livraison-tunnels.html"
    },
    {
      "source": "/(webinaire|vsl|appel-conference|temoignages|al-baraka-200|video-1|video-2|video-3)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.|plateforme\\.|view\\.)?albarakaecosysteme\\.com"
        }
      ],
      "destination": "/introuvable.html"
    },
    {
      "source": "/(webinaire|vsl|appel-conference|temoignages|al-baraka-200|video-1|video-2|video-3)/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.|plateforme\\.|view\\.)?albarakaecosysteme\\.com"
        }
      ],
      "destination": "/introuvable.html"
    },
    {
      "source": "/site-vitrine",
      "missing": [
        {
          "type": "host",
          "value": "^(plateforme\\.|view\\.|event\\.)albarakaecosysteme\\.com$"
        }
      ],
      "destination": "/vitrine.html"
    },
    {
      "source": "/site-vitrine/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "^(plateforme\\.|view\\.|event\\.)albarakaecosysteme\\.com$"
        }
      ],
      "destination": "/vitrine.html"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?albarakaecosysteme\\.com$"
        }
      ],
      "destination": "/vitrine.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app.html"
    }
  ]
}
